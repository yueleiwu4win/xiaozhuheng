<?xml version="1.0" encoding="utf-8"?>
<!--
  系统级自动备份（Android 12+ / API 31+）：
  - cloud-backup：云端自动备份（依赖设备厂商或 Google 备份服务）
  - device-transfer：换机克隆（小米「手机克隆」等迁移工具走此规则）
  数据库整域纳入（含 WAL/SHM），设置与背景图一并带上；不含缓存。
  注意：卸载应用仍会删除本机数据，重要数据请仍用「导出 JSON 备份」。
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="file" path="backgrounds/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="file" path="backgrounds/" />
    </device-transfer>
</data-extraction-rules>
